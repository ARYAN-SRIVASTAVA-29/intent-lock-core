ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# Zero-setup local development (default if omitted):
DATABASE_URL=sqlite:///./intentlock.db

# PostgreSQL path for the hackathon/deployment architecture:
# DATABASE_URL=postgresql+psycopg://intentlock:intentlock@localhost:5432/intentlock

# Paste credentials generated in your own Razorpay Dashboard while TEST MODE is selected.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-only secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GEMINI_API_KEY=

# Authentication/session. Replace AUTH_SECRET before any public deployment.
AUTH_SECRET=intentlock-dev-secret-change-before-deploy
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
